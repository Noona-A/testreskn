# Copy to .env (local) or add as GitHub Actions repository variables/secrets for deploys.
# All values are optional. Features stay hidden until configured.

# Amazon Associates UK tracking ID. Turns product links in guides into affiliate links.
VITE_AMAZON_TAG=

# Shopify Collabs referral for belantti.co.uk (defaults to the existing code in src/lib/affiliates.ts).
VITE_BELANTTI_REF=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456. Ad slots render only when set.
VITE_ADSENSE_CLIENT=
